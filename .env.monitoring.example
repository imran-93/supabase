# ============================================
# Dependency Monitoring Configuration
# ============================================

# Health Check Monitoring
# How often to check service health endpoints (milliseconds)
HEALTH_CHECK_INTERVAL=30000

# How often to poll RSS feeds for status updates (milliseconds)
RSS_FEED_CHECK_INTERVAL=300000

# ============================================
# Admin Email Notifications
# ============================================

# Email provider to use for notifications
# Options: resend, sendgrid, ses, smtp
ADMIN_EMAIL_PROVIDER=resend

# Email address to send from
ADMIN_EMAIL_FROM=noreply@platform.local

# Optional: Reply-to email address
ADMIN_EMAIL_REPLY_TO=support@platform.local

# API key for email provider
# For Resend: https://resend.com/api-keys
# For SendGrid: https://app.sendgrid.com/settings/api_keys
ADMIN_EMAIL_API_KEY=your_api_key_here

# Fallback email address if org admins cannot be fetched
# This email will receive notifications if the admin lookup fails
ADMIN_FALLBACK_EMAIL=admin@platform.local

# ============================================
# SMTP Configuration (if using SMTP provider)
# ============================================

# SMTP server hostname
SMTP_HOST=smtp.example.com

# SMTP port
SMTP_PORT=587

# Use TLS/SSL
SMTP_SECURE=false

# SMTP authentication username
SMTP_USER=username

# SMTP authentication password
SMTP_PASS=password

# ============================================
# Supabase Configuration (required for admin lookup)
# ============================================

# Your Supabase instance URL
NEXT_PUBLIC_SUPABASE_URL=https://your-instance.supabase.co

# Supabase service role key (for fetching admin users)
# IMPORTANT: Keep this secret! Never expose in client code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# Email Provider Setup Guides
# ============================================

# RESEND SETUP:
# 1. Sign up at https://resend.com
# 2. Create API key in dashboard
# 3. Verify your domain or use free @resend.dev domain
# 4. Set ADMIN_EMAIL_PROVIDER=resend
# 5. Set ADMIN_EMAIL_API_KEY=re_xxxxx

# SENDGRID SETUP:
# 1. Create account at https://sendgrid.com
# 2. Create API key with Mail Send permission
# 3. Verify sender identity
# 4. Set ADMIN_EMAIL_PROVIDER=sendgrid
# 5. Set ADMIN_EMAIL_API_KEY=SG.xxxxx

# AWS SES SETUP:
# 1. Set up SES in AWS console
# 2. Verify sender email
# 3. Create IAM credentials with SES SendEmail permission
# 4. Set ADMIN_EMAIL_PROVIDER=ses
# 5. Set AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# SMTP SETUP (Corporate Email):
# 1. Get SMTP details from your email provider
# 2. Set ADMIN_EMAIL_PROVIDER=smtp
# 3. Configure SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
# 4. Test with `telnet SMTP_HOST SMTP_PORT`

# ============================================
# Optional: Monitoring Integrations
# ============================================

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=https://key@sentry.io/project

# DataDog API key (if using DataDog)
DATADOG_API_KEY=

# Custom webhook URL for incidents
INCIDENT_WEBHOOK_URL=https://hooks.slack.com/services/T/B/C

# ============================================
# Optional: Cleanup and Maintenance
# ============================================

# How many days of incident history to keep
INCIDENT_HISTORY_RETENTION_DAYS=30

# Enable automatic cleanup of old incidents (true/false)
ENABLE_INCIDENT_CLEANUP=true
